{
  "expo": {
    "name": "墨墨背单词",
    "slug": "vocab-app",
    "version": "2.0.0",
    "orientation": "default",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#2ed573",
      "resizeMode": "contain"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2ed573"
      },
      "package": "com.vocabapp.learn"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vocabapp.learn"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2ed573",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d3975ed5-1166-47dc-a3df-b42a3b274654"
      }
    }
  }
}
